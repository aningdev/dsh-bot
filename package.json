{
  "name": "@dsh-bot/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Bun workspaces for dsh-bot clients and the DeepSeek Harness runtime",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run dsh-bot#start",
    "start": "vp run dsh-bot#start",
    "build": "vp run dsh-bot#package",
    "package": "vp run dsh-bot#package",
    "make": "vp run dsh-bot#make",
    "release": "vp run dsh-bot#release",
    "check": "vp run verify",
    "fix": "vp check --fix",
    "test": "vp run test:unit",
    "test:unit": "vp run unit",
    "test:e2e": "vp run e2e",
    "test:smoke": "vp run smoke",
    "test:all": "vp run verifyAll",
    "harness": "vp run @dsh-bot/harness-runtime#dsh",
    "prepare": "vp config --no-agent",
    "hooks:enable": "vp hooks enable",
    "hooks:status": "vp hooks status"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.15.0 || >=26.0.0"
  },
