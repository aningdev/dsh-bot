{
  "name": "@dsh-bot/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare:sdk": "bun scripts/prepare-client.ts",
    "dev": "bun run prepare:sdk && bun scripts/dev.ts",
    "check": "bun run prepare:sdk && bun run --cwd apps/client check",
    "build": "bun run prepare:sdk && bun run --cwd apps/client build",
    "host:dev": "cargo run --manifest-path apps/host/Cargo.toml -- serve-app",
    "test": "bun run prepare:sdk && bun run test:host && bun run test:relay && bun run --cwd apps/client test",
    "test:relay": "cargo test -p dsh-relay",
    "test:e2e": "bun run prepare:sdk && bun run --cwd apps/client test:e2e",
    "test:startup": "bun run prepare:sdk && bun scripts/test-client-startup.ts",
    "package:macos": "bun scripts/package-macos.ts",
    "test:host": "cargo test --manifest-path apps/host/Cargo.toml",
    "test:host-client": "bun run prepare:sdk && bun scripts/test-host-client.ts",
    "test:package": "bun scripts/smoke-package.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.15.0 || >=26.0.0"
  }
}
