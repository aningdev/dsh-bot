{
  "name": "@dsh-bot/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare:sdk": "bun scripts/prepare-client.ts",
    "dev": "bun run prepare:sdk && bun run --cwd apps/client dev",
    "check": "bun run prepare:sdk && bun run --cwd apps/client check",
    "build": "bun run prepare:sdk && bun run --cwd apps/client build",
    "test": "bun run prepare:sdk && bun run test:backend && bun run test:host && bun run --cwd apps/client test",
    "test:e2e": "bun run prepare:sdk && bun run --cwd apps/client test:e2e",
    "package:macos": "bun scripts/package-macos.ts",
    "package:macos:host": "bun scripts/package-macos.ts --host-preview",
    "test:host": "cargo test --manifest-path apps/host/Cargo.toml",
    "test:host-client": "bun run prepare:sdk && bun scripts/test-host-client.ts",
    "test:package": "bun scripts/smoke-package.ts",
    "backend": "bun scripts/backend/cli.ts",
    "backend:install": "bun scripts/backend/cli.ts install",
    "backend:start": "bun scripts/backend/cli.ts start",
    "backend:stop": "bun scripts/backend/cli.ts stop",
    "test:backend": "bun test scripts/backend/launchd.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.15.0 || >=26.0.0"
  }
}
