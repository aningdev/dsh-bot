{
  "name": "@dsh-bot/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Bun workspaces for dsh-bot clients and the DeepSeek Harness runtime",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter dsh-bot start",
    "start": "bun run --filter dsh-bot start",
    "build": "bun run --filter dsh-bot package",
    "package": "bun run --filter dsh-bot package",
    "make": "bun run --filter dsh-bot make",
    "release": "bun run --filter dsh-bot release",
    "check": "bun run --filter @dsh-bot/bot build && vp check && bun run --filter @dsh-bot/harness-runtime check",
    "test": "bun run test:unit",
    "test:unit": "bun run --workspaces --if-present test:unit",
    "test:e2e": "bun run --cwd apps/runner build:test && bun run --filter dsh-bot test:e2e",
    "test:smoke": "bun run --filter dsh-bot test:smoke",
    "test:all": "bun run check && bun run test:unit && bun run test:e2e && bun run test:smoke",
    "harness": "bun run --cwd packages/harness-runtime dsh",
    "fix": "vp check --fix",
    "prepare": "vp config --no-agent",
    "hooks:enable": "vp hooks enable",
    "hooks:status": "vp hooks status"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^24.15.0 || >=26.0.0"
  },
  "patchedDependencies": {
    "@electron-forge/core-utils@8.0.1": "patches/@electron-forge%2Fcore-utils@8.0.1.patch",
    "@deepseek-ai/dsh-typert-generator@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh-typert-generator@0.2.1-rc.2.patch",
    "@deepseek-ai/dsh-typert-protocol@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh-typert-protocol@0.2.1-rc.2.patch",
    "@deepseek-ai/dsh-api-gateway@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh-api-gateway@0.2.1-rc.2.patch",
    "@deepseek-ai/dsh-api-session-controller@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh-api-session-controller@0.2.1-rc.2.patch",
    "@deepseek-ai/dsh-client-file-upload@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh-client-file-upload@0.2.1-rc.2.patch",
    "@deepseek-ai/dsh@0.2.1-rc.2": "patches/@deepseek-ai%2Fdsh@0.2.1-rc.2.patch"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
