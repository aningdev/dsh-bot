{
  "name": "@dsh-bot/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Bun workspaces for dsh-bot clients and the DeepSeek Harness runtime",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter dsh-bot start",
    "start": "bun run --filter dsh-bot start",
    "build": "bun run --filter dsh-bot package",
    "package": "bun run --filter dsh-bot package",
    "make": "bun run --filter dsh-bot make",
    "release": "bun run --filter dsh-bot release",
    "check": "bun run --workspaces --if-present check",
    "test": "bun run test:unit",
    "test:unit": "bun run --workspaces --if-present test:unit",
    "test:e2e": "bun run --filter dsh-bot test:e2e",
    "test:smoke": "bun run --filter dsh-bot test:smoke",
    "test:all": "bun run check && bun run test:unit && bun run test:e2e && bun run test:smoke",
    "harness": "bun run --cwd packages/harness-runtime dsh"
  },
  "overrides": {
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^24.15.0 || >=26.0.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "patchedDependencies": {
    "@electron-forge/core-utils@8.0.1": "patches/@electron-forge%2Fcore-utils@8.0.1.patch"
  }
}
