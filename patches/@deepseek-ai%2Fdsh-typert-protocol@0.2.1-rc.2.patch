@@ -0,0 +1,24 @@
+/** A bounded Host operation; release is idempotent and awaited by its caller. */
+export interface OperationLease {
+  /** Invocation cancellation, including withdrawal of its owner. */
+  readonly signal?: AbortSignal;
+  /** Opening streams release replacement access early, while consumer cleanup remains tracked. */
+  readonly lifetime?: 'call' | 'opening';
+  /** Release opening access without ending cancellation and consumer tracking. */
+  releaseOpening?(): void | Promise<void>;
+  /** Release after cleanup; an optional cleanup failure is also reported by retirement. */
+  release(failure?: unknown): void | Promise<void>;
+}
+/** Acquire before using Host objects; undefined delegates an unmanaged operation. */
+export type OperationGuard<Request> = (request: Request & { readonly signal: AbortSignal }) => OperationLease | undefined | Promise<OperationLease | undefined>;
+/** A single effect-owned guard; withdrawal cancels and drains it, then fails closed. */
+export declare class OperationGuardRegistry<Request extends { readonly signal?: AbortSignal }> {
+  readonly enabled: boolean;
+  constructor(unavailable: () => Error);
+  /** Register one provider; the caller owns and awaits the returned disposer. */
+  register(guard: OperationGuard<Request>): () => Promise<void>;
+  /** Acquire an invocation-owned lease after checking owner retirement. */
+  acquire(request: Request): Promise<OperationLease | undefined>;
+  /** Hold a lease through an asynchronous operation and release it on every outcome. */
+  run<T>(request: Request, operation: (signal: AbortSignal) => Promise<T> | T): Promise<T>;
+}
