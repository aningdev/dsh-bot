index 0000000000000000000000000000000000000000..d47b45a660371758616f20f531392f15e2a9ca9b
--- /dev/null
+++ b/lib/operation-guard.js
@@ -0,0 +1,57 @@
+/** Single-owner operation guards with retirement and invocation-owned release. */
+export class OperationGuardRegistry {
+  neverAborted = new AbortController().signal;
+  registration;
+  retired = false;
+  get enabled() { return this.registration !== undefined || this.retired; }
+  constructor(unavailable) { this.unavailable = unavailable; }
+  register(guard) {
+    if (this.registration !== undefined) throw new Error('An operation guard is already registered');
+    const registration = { guard, lifetime: new AbortController(), active: 0, drained: undefined, failures: [] };
+    this.registration = registration;
+    this.retired = false;
+    let closing;
+    return () => closing ??= (async () => {
+      registration.lifetime.abort(this.unavailable());
+      this.retired = true;
+      if (registration.active > 0) await new Promise(resolve => { registration.drained = resolve; });
+      if (this.registration === registration) this.registration = undefined;
+      if (registration.failures.length > 0) throw new AggregateError(registration.failures, 'Operation cleanup failed');
+    })();
+  }
+  async acquire(request) {
+    const registration = this.registration;
+    if (this.retired) throw this.unavailable();
+    if (registration === undefined) return undefined;
+    const signal = AbortSignal.any([request.signal ?? this.neverAborted, registration.lifetime.signal]);
+    signal.throwIfAborted();
+    registration.active++;
+    const finish = () => {
+      registration.active--;
+      if (registration.active === 0) registration.drained?.();
+    };
+    let lease;
+    try {
+      lease = await registration.guard({ ...request, signal });
+      signal.throwIfAborted();
+    } catch (error) {
+      try { await lease?.release(); } finally { finish(); }
+      throw error;
+    }
+    if (lease === undefined) { finish(); return undefined; }
+    let closing;
+    let released;
+    const releaseOwned = () => released ??= Promise.resolve().then(() => lease.release()).catch(error => { registration.failures.push(error); throw error; });
+    return {
+      signal,
+      lifetime: lease.lifetime,
+      releaseOpening: lease.lifetime === 'opening' ? releaseOwned : undefined,
+      release: failure => closing ??= (async () => { if (failure !== undefined) registration.failures.push(failure); try { await releaseOwned(); } finally { finish(); } })(),
+    };
+  }
+  async run(request, operation) {
+    const lease = await this.acquire(request);
+    try { return await operation(lease?.signal ?? request.signal ?? this.neverAborted); }
+    finally { await lease?.release(); }
+  }
+}
