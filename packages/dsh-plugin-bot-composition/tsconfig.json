{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": false,
    "noEmitOnError": true,
    "types": ["bun-types"]
  },
  "include": ["src/index.ts", "src/composition.ts", "src/store.ts"]
}
