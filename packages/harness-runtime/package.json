{
  "name": "@dsh-bot/harness-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Pinned npm runtime for the dsh-bot Harness profiles",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dsh --version",
    "dsh": "dsh"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "catalog:",
    "@deepseek-ai/dsh-agent-preset": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-settings-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-file-upload": "catalog:",
    "@deepseek-ai/dsh-file-reference-local": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-tool-bash": "catalog:",
    "@deepseek-ai/dsh-tool-fs": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
