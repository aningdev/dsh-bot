{
  "name": "@dsh-bot/bot",
  "version": "0.0.1",
  "private": true,
  "description": "Bot product Controller and profile bundle",
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/session-controller.js",
    "lib/types",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-controller": {
      "types": "./lib/types/session-controller.d.ts",
      "default": "./lib/session-controller.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "bun run build && tsc --noEmit -p tests/tsconfig.json",
    "test:unit": "bun run build && vp test run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
