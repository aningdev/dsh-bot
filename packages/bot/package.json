{
  "name": "@dsh-bot/bot",
  "version": "0.0.1",
  "private": true,
  "description": "Bot product Controller and profile bundle",
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/session-controller.js",
    "lib/types",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-controller": {
      "types": "./lib/types/session-controller.d.ts",
      "default": "./lib/session-controller.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp run build-artifacts",
    "check": "vp run check-types",
    "test:unit": "vp run unit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-fs-local": "catalog:",
    "@deepseek-ai/dsh-session-persistence-jsonl": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-storage": "catalog:",
    "@deepseek-ai/dsh-storage-json": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-typert-generator": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
