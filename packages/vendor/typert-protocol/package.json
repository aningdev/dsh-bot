{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "version": "0.2.1-rc.3",
  "private": true,
  "description": "Vendored type declarations of @deepseek-ai/dsh-typert-protocol for build-time Typert analysis; not a workspace package and never resolved at runtime",
