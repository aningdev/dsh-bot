      "default": "./src/types.d.ts"
    },
    "./remote-info": {
      "types": "./src/remote-info.d.ts",
      "default": "./src/remote-info.d.ts"
    },
    "./remote-access": {
      "types": "./src/remote-access.d.ts",
      "default": "./src/remote-access.d.ts"
    },
    "./principal": {
      "types": "./src/principal.d.ts",
      "default": "./src/principal.d.ts"
    },
    "./json-value": {
      "types": "./src/json-value.d.ts",
      "default": "./src/json-value.d.ts"
    },
    "./owned-value": {
      "types": "./src/owned-value.d.ts",
      "default": "./src/owned-value.d.ts"
    },
    "./remote-error": {
      "types": "./src/remote-error.d.ts",
      "default": "./src/remote-error.d.ts"
    },
    "./package.json": "./package.json"
  }
