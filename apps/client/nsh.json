{
  "name": "DSH Bot",
  "id": "dev.dshbot.client",
  "version": "0.1.0",
  "build": 1,
  "rust": ".",
  "capabilities": {
    "network": {
      "hosts": ["127.0.0.1"]
    },
    "fs": {
      "read": ["/"],
      "write": ["${homeDir}/.dsh-bot/bots", "${homeDir}/.dsh-bot-e2e", "${dataDir}"]
    },
    "process": {
      "execute": ["/usr/bin/id", "/bin/launchctl"],
      "env": ["DSH_BOTS_HOME", "DSH_E2E_FAULT", "DSH_HOST_SOCKET"]
    }
  }
}
