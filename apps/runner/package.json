{
  "name": "@dsh-bot/runner",
  "version": "0.0.1",
  "private": true,
  "description": "Named-profile Harness Host managed independently of the desktop",
  "type": "module",
  "scripts": {
    "build": "vp run @dsh-bot/bot#build && vp build",
    "build:test": "vp run build && vp build --mode test-fixtures",
    "start": "node --expose-internals lib/index.js",
    "check": "vp run @dsh-bot/bot#build && vp exec tsc --noEmit -p tsconfig.json && vp exec tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "vp run build:test && vp test run"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "catalog:",
    "@deepseek-ai/dsh-app-boot": "catalog:",
    "@deepseek-ai/dsh-base": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@dsh-bot/bot": "workspace:*",
    "@dsh-bot/harness-runtime": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-api-gateway": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-file-upload": "catalog:",
    "@deepseek-ai/dsh-file-reference": "catalog:",
    "@deepseek-ai/dsh-file-reference-local": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-typert-registry": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "ws": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
